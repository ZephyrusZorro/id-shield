# ================= ID-SHIELD environment configuration =================
# Copy to .env and adjust. NEVER commit the real .env file.

# ---- Backend ----
# SQLite is the demo default; swap to PostgreSQL without code changes, e.g.:
#   postgresql+psycopg2://idshield:idshield@localhost:5432/idshield
DATABASE_URL=sqlite:///./data/idshield.db

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# Uploaded document storage directory (created automatically)
UPLOAD_DIR=./data/uploads

# Maximum accepted upload size per file, in megabytes
MAX_UPLOAD_MB=10

# Optional module flags (P2 capabilities are stubbed while false)
FACE_VERIFICATION_ENABLED=false

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- Live Notification Providers (Optional) ----
# If left empty, ID-SHIELD runs in High-Fidelity Simulator Mode with logged audit receipts.
#
# 1. Real Email Delivery (e.g. Gmail SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
# SMTP_FROM=your_email@gmail.com
#
# 2. Real Indian Mobile SMS (Fast2SMS)
# FAST2SMS_API_KEY=your_fast2sms_api_key
#
# 3. Real Global SMS & WhatsApp (Twilio)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890

# ---- Frontend (Vite) ----
# Base URL used by the browser to reach the backend API.
# In dev, leave empty to use the Vite proxy (/api -> http://localhost:8000).
VITE_API_BASE=
